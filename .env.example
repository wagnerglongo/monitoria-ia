# Copie para .env e ajuste. Nunca suba o .env para o Git.

# "demo" roda sem chave (transcrições de exemplo + avaliação por sinais no texto).
# "openai" transcreve o áudio e avalia com o modelo abaixo.
IA_PROVEDOR=demo
OPENAI_API_KEY=
OPENAI_MODELO_TRANSCRICAO=whisper-1
OPENAI_MODELO_AVALIACAO=gpt-4o-mini

# Acesso ao painel e à API (HTTP Basic). Obrigatório com IA_PROVEDOR=openai.
MONITORIA_USUARIO=monitor
MONITORIA_SENHA=

# Senha do PostgreSQL do docker-compose
DB_SENHA=troque-esta-senha

# Opcionais
# TAMANHO_MAXIMO_MB=100
# MAX_TENTATIVAS=3
# INTERVALO_WORKER=5
# RUBRICA=rubricas/cobranca.json
